# Copy is NOT needed for local dev: `pnpm setup` / `pnpm dev` write apps/web/.env.local
# from `supabase status`. This file documents every variable.

# Origins (D17: proxy must be a different origin from the app)
APP_ORIGIN=http://localhost:3000
PROXY_ORIGIN=http://localhost:8787

# Local Supabase (values come from `supabase status -o env`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
MAILPIT_URL=http://127.0.0.1:54324

# HMAC secret shared by app and proxy (generated into .run/proxy-token-secret)
PROXY_TOKEN_SECRET=

# D30 adapter selection: local | mock  (cloud arrives in Phase B / M7)
TRANSCRIBER=local
ANCHOR_RESOLVER=local
SCREENSHOT=local
MAILER=local
PROXY_HOST=local
# MOCK_AI=1 forces mock Transcriber + AnchorResolver (default inside pnpm verify)
MOCK_AI=0

# Local AI services
WHISPER_URL=http://127.0.0.1:8178
OLLAMA_URL=http://127.0.0.1:11434
ANCHOR_MODEL=qwen3:14b

# Proxy-only (apps/proxy/.dev.vars)
ALLOWED_APP_ORIGINS=http://localhost:3000
ENVIRONMENT=development
# Honored only when ENVIRONMENT=test (fixtures on localhost)
ALLOW_FIXTURE_HOSTS=
