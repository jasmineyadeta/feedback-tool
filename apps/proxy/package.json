{
  "name": "@ft/proxy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gen": "pnpm --filter @ft/overlay build && node scripts-gen-overlay.mjs",
    "dev": "node scripts-gen-overlay.mjs && wrangler dev --port 8787 --ip 127.0.0.1",
    "dev:test": "node scripts-gen-overlay.mjs && wrangler dev --port 8788 --ip 127.0.0.1 --env test",
    "typecheck": "node scripts-gen-overlay.mjs && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@ft/shared": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261031.1",
    "wrangler": "4.156.0"
  }
}
